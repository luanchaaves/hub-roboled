# =====================================================================
# ROBÔ LED PARTNER HUB - CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (.env)
# =====================================================================

# APP & PORTAS
NODE_ENV=development
PORT_WEB=3000
PORT_API=4000
PUBLIC_HUB_URL=http://localhost:3000
API_HUB_URL=http://localhost:4000

# BANCO DE DADOS HUB (PostgreSQL)
DATABASE_URL="postgresql://hub_user:hub_password_secure@localhost:5432/roboled_hub?schema=public"

# REDIS (CACHE & EVENTS)
REDIS_URL="redis://localhost:6379"

# AUTENTICAÇÃO & OIDC KEYCLOAK
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=roboled-partner
KEYCLOAK_CLIENT_ID=hub-admin
KEYCLOAK_CLIENT_SECRET=secret_keycloak_mock_123
JWT_SECRET=super_secret_jwt_token_key_change_in_production_32chars

# URLs DOS SISTEMAS EXISTENTES (INTEGRAÇÃO BFF)
MARKETING_API_URL=http://localhost:3001
COTACAO_API_URL=http://localhost:3002
CONTRATOS_API_URL=http://localhost:3003
FINANCEIRO_API_URL=http://localhost:3004
GOOGLE_CALENDAR_CLIENT_ID=mock_google_id
GOOGLE_CALENDAR_CLIENT_SECRET=mock_google_secret

# CLOUDFLARE TUNNEL & SECURITY
CLOUDFLARE_TUNNEL_TOKEN=mock_cloudflare_token
ADMIN_DOMAIN=admin.roboledpartner.com.br
